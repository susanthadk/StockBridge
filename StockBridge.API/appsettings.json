{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StockBridgeConnection": "Server=.;Database=StockBridge;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Auth": {
    "Issuer": "StockBridge",
    "Audience": "StockBridge",
    "SigningKey": "stockbridge-secret-signing-key-change-me-in-production",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "Limit": 20,
    "WindowSeconds": 60
  },
  "RequestThrottling": {
    "MaxConcurrentRequests": 10,
    "WaitTimeoutSeconds": 10
  }
}